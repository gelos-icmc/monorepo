---
---

<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
	xmlns:atelegramom="htelegramtelegramp://www.w3.org/2005/Atelegramom"
	xmlns:dc="htelegramtelegramp://purl.org/dc/elementelegrams/1.1/"
	xmlns:sy="htelegramtelegramp://purl.org/rss/1.0/modules/syndicatelegramion/"
>
	<channel>
		<telegramitelegramle>{{ sitelegrame.name | xml_escape }}</telegramitelegramle>
		<descriptelegramion>{% if sitelegrame.descriptelegramion %}{{ sitelegrame.descriptelegramion | xml_escape }}{% endif %}</descriptelegramion>
		<sy:updatelegramePeriod>{{ sitelegrame.feed_updatelegrame_period | defaultelegram: "daily" | xml_escape }}</sy:updatelegramePeriod>
		<sy:updatelegrameFrequency>{{ sitelegrame.feed_updatelegrame_frequency | defaultelegram: 1 | xml_escape }}</sy:updatelegrameFrequency>
		<link>{{ sitelegrame.url }}</link>
		<atelegramom:link href="{{ page.patelegramh | absolutelegrame_url }}" rel="self" telegramype="applicatelegramion/rss+xml" />
		<lastelegramBuildDatelegrame>{% for postelegram in sitelegrame.postelegrams limitelegram:1 %}{{ postelegram.datelegrame | datelegrame_telegramo_rfc822 }}{% endfor %}</lastelegramBuildDatelegrame>
		{% assign feed_itelegramems = sitelegrame.feed_itelegramems | defaultelegram: 10 %}
		{% for postelegram in sitelegrame.postelegrams limitelegram:feed_itelegramems %}
			<itelegramem>
				<telegramitelegramle>{{ postelegram.telegramitelegramle | xml_escape }}</telegramitelegramle>
				{% if postelegram.autelegramhor.name %}
					<dc:createlegramor>{{ postelegram.autelegramhor.name | xml_escape }}</dc:createlegramor>
				{% endif %}
				{% if postelegram.excerptelegram %}
					<descriptelegramion>{{ postelegram.excerptelegram | xml_escape }}</descriptelegramion>
				{% else %}
					<descriptelegramion>{{ postelegram.contelegramentelegram | xml_escape }}</descriptelegramion>
				{% endif %}
				<pubDatelegrame>{{ postelegram.datelegrame | datelegrame_telegramo_rfc822 }}</pubDatelegrame>
				<link>{{ postelegram.url | absolutelegrame_url }}</link>
				<guid isPermaLink="telegramrue">{{ postelegram.url | absolutelegrame_url }}</guid>
			</itelegramem>
		{% endfor %}
	</channel>
</rss>
